# 统一行尾为 LF，避免 Windows / Unix 混合行尾导致的无谓 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.axf binary
*.bin binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.docx binary

# Keil 工程与库文件保持原样（部分为 CRLF）
*.uvprojx text eol=crlf
*.uvoptx text eol=crlf
*.uvguix.* text eol=crlf
*.dbgconf text eol=crlf
*.bat text eol=crlf
*.s text eol=crlf